# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python follows PEP 8 / Ruff indentation conventions.
[*.py]
indent_size = 4

# Markdown may intentionally use trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Windows command scripts conventionally use CRLF.
[*.{bat,cmd}]
end_of_line = crlf
